# StreamPulse Admin (Vercel)
# URL of the deployed Render signaling server
NEXT_PUBLIC_STREAM_SERVER_URL=https://streampulse-server.onrender.com

# Public URL of this admin deployment (optional)
NEXT_PUBLIC_APP_URL=https://streampulse-admin.vercel.app

# Optional TURN Server Configuration (for restrictive NAT/Firewall environments)
# NEXT_PUBLIC_TURN_URL=turn:your-turn-server.com:3478
# NEXT_PUBLIC_TURN_USERNAME=your_turn_user
# NEXT_PUBLIC_TURN_CREDENTIAL=your_turn_password
